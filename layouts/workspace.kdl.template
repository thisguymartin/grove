layout {
    // {{DEFAULT_TAB_TEMPLATE}}
    // Overview tab — concise repository status
    tab name="Overview" color="cyan" cwd="{{GROVE_INSTALL_DIR}}" {
        pane command="bash" name="Overview Status" {
            args "-c" "while true; do if [ -n \"${GROVE_STATUS_BIN:-}\" ] && [ -x \"$GROVE_STATUS_BIN\" ]; then _out=$(\"$GROVE_STATUS_BIN\" status \"{{REPO_PATH}}\" 2>&1); else _out=$(bash ./worktree-status.sh \"{{REPO_PATH}}\" 2>&1); fi; clear; printf '%s' \"$_out\"; sleep 30; done"
        }
    }

    // {{WORKTREE_TABS}}
}
